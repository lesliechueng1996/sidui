{
  "name": "@sidui/api",
  "version": "1.0.50",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "types": "./src/index.ts",
  "module": "./src/index.ts",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "check": "biome check .",
    "typecheck": "tsc --noEmit",
    "fix": "biome check --write .",
    "test": "bun test --isolate",
    "test:cov": "bun test --isolate --coverage --coverage-reporter=text --coverage-reporter=lcov"
  },
  "dependencies": {
    "@elysia/openapi": "^1.4.15",
    "@elysiajs/cors": "^1.4.2",
    "@sidui/db": "workspace:*",
    "@sidui/jx3api": "workspace:*",
    "@logtape/drizzle-orm": "^2.3.1",
    "@logtape/elysia": "^2.3.0",
    "@logtape/file": "^2.3.0",
    "@logtape/logtape": "^2.3.0",
    "better-auth": "^1.6.26",
    "date-fns": "^4.4.0",
    "elysia": "latest",
    "pinyin-pro": "^3.28.2"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "bun-types": "latest"
  }
}
