{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Flutter (MacOS)",
      "type": "dart",
      "request": "launch",
      "program": "${workspaceFolder}/apps/cook_app/lib/main.dart",
      "cwd": "${workspaceFolder}/apps/cook_app",
      "flutterMode": "debug",
      "args": [
        "-d",
        "macos",
        "--dart-define-from-file=.env"
      ]
      
    },
    {
      "type": "bun",
      "request": "launch",
      "name": "Debug API (dev)",
      "program": "${workspaceFolder}/apps/api/src/index.ts",
      "cwd": "${workspaceFolder}/apps/api",
      "watchMode": true,
      "runtime": "bun",
      "strictEnv": false,
      "stopOnEntry": false
    }
  ]
}
